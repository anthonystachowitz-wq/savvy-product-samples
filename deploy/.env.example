# Domain the demo is served on. Point an A record at the host first.
DEMO_DOMAIN=transition-sample.example.com

# recorded = replay recorded live calls (default, no key needed)
# live = make fresh calls inside the daily budget below
SAVVY_LLM_MODE=live
SAVVY_LLM_DAILY_LIMIT=150

# Only needed when SAVVY_LLM_MODE=live. Never commit the real value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
